<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Calculator" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>
<!--  -->
    <style name="Theme.Calculator" parent="Base.Theme.Calculator" />

    <style name="CalcBtn" parent="Widget.Material3.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">6dp</item>
        <item name="cornerRadius">0dp</item>
        <item name="android:insetTop">3dp</item>
        <item name="android:insetBottom">3dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetLeft">10dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textSize">30sp</item>
        <item name="rippleColor">#4DFFFFFF</item>
    </style>

    <style name="CalcBtn.Number">
        <item name="backgroundTint">@color/num_button_bg</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">15dp</item>
    </style>

    <style name="CalcBtn.Function">
        <item name="backgroundTint">@color/func_button_bg</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="CalcBtn.Operator">
        <item name="backgroundTint">@color/op_button_bg</item>
        <item name="android:textColor">@color/white</item>
    </style>





</resources>
